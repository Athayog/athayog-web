# ==========================================================================
# Athayog Living Web — Environment Variables
# --------------------------------------------------------------------------
# 1. Copy this file to .env.local and fill in real values.
# 2. NEVER commit .env.local (it is git-ignored).
# 3. On Vercel, add the same variables in Project → Settings → Environment
#    Variables. Server secrets (no NEXT_PUBLIC_ prefix) stay server-only.
# 4. Keep this file in sync when adding/removing variables — see
#    docs/deployment.md for the canonical table.
# ==========================================================================

# --- Firebase (client) — public by design, from Firebase console → Project settings ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Note: no underscore before APPID
NEXT_PUBLIC_FIREBASE_APPID=

# --- Firebase Admin (server only) — from the service account JSON ---
# FIREBASE_PRIVATE_KEY must keep the literal \n escapes (copy the JSON value as-is).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Prismic (client) ---
NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=athayog

# --- Razorpay (payments) ---
# Public key id (rzp_test_... for test, rzp_live_... for production).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server secret — must match the key id above.
RAZORPAY_KEY_SECRET=
# Server secret — must match the Razorpay dashboard webhook configuration.
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend, server only) ---
RESEND_API_KEY=

# --- Prismic revalidation (server only) ---
# Shared secret for POST /api/revalidate. Send it as the x-revalidate-token
# header (or wire it to the Prismic webhook). The endpoint returns 503 until
# this is set.
REVALIDATE_TOKEN=

# --- Optional ---
# Google One Tap sign-in client id (from Google Cloud Console). If empty,
# login silently falls back to the Google popup flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
